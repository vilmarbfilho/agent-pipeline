# --- Credenciais ----------------------------------------------------------
# Obrigatória para --provider anthropic (dispensável se você usou `ant auth login`).
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: proxy/gateway compatível com a Messages API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenRouter (ORCH_PROVIDER=openrouter) -----------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://github.com/voce/orchestrator   # atribuição opcional
# OPENROUTER_APP_NAME=orchestrator

# --- Modelo -----------------------------------------------------------------
ORCH_PROVIDER=anthropic          # anthropic | openrouter | mock (mock = roteiro offline, sem API key)
# ORCH_MODEL: vazio = claude-opus-5-5 no provedor anthropic.
# No openrouter é obrigatório e usa o slug do OpenRouter (https://openrouter.ai/models),
# ex.: anthropic/claude-sonnet-4.5, openai/gpt-5, google/gemini-2.5-pro
ORCH_MODEL=
ORCH_EFFORT=high                 # low | medium | high | xhigh | max (openrouter: xhigh/max -> high)
ORCH_FALLBACKS=true              # só anthropic: fallback server-side em recusas de segurança
ORCH_MAX_TOKENS=64000

# --- Limites do pipeline ----------------------------------------------------
ORCH_MAX_STEPS=40                # passos ReAct por fase
ORCH_MAX_REVIEW_ROUNDS=1         # rodadas de correção após reprovação do Reviewer
ORCH_COMMAND_TIMEOUT=2m          # timeout máximo do run_command

# --- Segurança ----------------------------------------------------------------
ORCH_CONFIRM_ALL_WRITES=false    # true = confirmar TODA escrita (não só as sensíveis)
