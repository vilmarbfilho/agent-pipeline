# --- Credenciais ----------------------------------------------------------
# Obrigatória para --provider anthropic (dispensável se você usou `ant auth login`).
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: proxy/gateway compatível com a Messages API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Modelo -----------------------------------------------------------------
ORCH_PROVIDER=anthropic          # anthropic | mock (mock = roteiro offline, sem API key)
ORCH_MODEL=claude-opus-5-5
ORCH_EFFORT=high                 # low | medium | high | xhigh | max
ORCH_FALLBACKS=true              # fallback server-side em recusas de segurança
ORCH_MAX_TOKENS=64000

# --- Limites do pipeline ----------------------------------------------------
ORCH_MAX_STEPS=40                # passos ReAct por fase
ORCH_MAX_REVIEW_ROUNDS=1         # rodadas de correção após reprovação do Reviewer
ORCH_COMMAND_TIMEOUT=2m          # timeout máximo do run_command

# --- Segurança ----------------------------------------------------------------
ORCH_CONFIRM_ALL_WRITES=false    # true = confirmar TODA escrita (não só as sensíveis)
